# Raven web client — environment
# Copy to `.env` and fill from your Supabase project (Settings → API).
# These are PUBLIC client keys; the anon key is safe to ship (RLS protects data).
# Never put the service_role key here — it bypasses RLS.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
