{
  "name": "raven-mobile",
  "version": "0.1.0",
  "description": "Raven — end-to-end encrypted messenger (Android, Capacitor)",
  "private": true,
  "scripts": {
    "build:web": "cross-env BUILD_TARGET=app VITE_BASE=./ node ../../node_modules/vite/bin/vite.js build ../web --outDir ../mobile/www --emptyOutDir",
    "sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "cross-env": "7.0.3"
  }
}
